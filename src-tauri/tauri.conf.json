{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spectia",
  "version": "1.0.0",
  "identifier": "io.github.bunnykrojink.spectia",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spectia",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https:; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.modrinth.com https://minecraft.wiki https://*.minecraft.wiki; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "bunnyKROJINK",
    "shortDescription": "Красивый лаунчер для Minecraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RkJCRENGMThEMkE4QkIKUldTN3FOSVl6NzM3U0ZqWjFpakFWNUdEVWE3cjN2TzJBN205ZTVSZVQxTHJmaFpCZExBME52bTIK",
      "endpoints": [
        "https://github.com/bunnyKROJINK/spectia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
